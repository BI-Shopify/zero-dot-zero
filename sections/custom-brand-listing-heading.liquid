{%- comment -%}
  Title + subtitle shown above the product listing on brand landing pages, e.g.
  "The Perfect Size for Every Moment" / "Discover our range". A section of its own rather
  than a setting on main-collection-product-grid, so the six collection layout snippets
  that section renders stay untouched.

  Text is template-wide (set here in the theme editor). Colours fall back to the heading
  colour of this collection's "Brand Banner" metaobject entry, so the title matches each
  brand's banner without anything being filled in here.

  data-listing-heading is the hook bi-custom.js uses so a button whose scroll target is
  'products' lands on this title instead of just below it.
{%- endcomment -%}

{%- liquid
    assign heading = section.settings.heading
    assign subheading = section.settings.subheading

    assign meta_banner = blank
    if template.name == 'collection' and collection != blank
        assign all_blocks = collection.metafields.custom.collection_content.value
        for block_item in all_blocks
            if block_item.system.type == 'brand_banner'
                assign meta_banner = block_item
                break
            endif
        endfor
    endif

    assign heading_color = section.settings.heading_color
    if heading_color == blank or heading_color == 'rgba(0,0,0,0)'
        assign heading_color = meta_banner.heading_color
    endif
    assign subheading_color = section.settings.subheading_color
    if subheading_color == blank or subheading_color == 'rgba(0,0,0,0)'
        assign subheading_color = meta_banner.subheading_color | default: heading_color
    endif
-%}

{%- if heading != blank or subheading != blank -%}
    <div
        class="brand-listing-heading brand-listing-heading--{{ section.settings.content_align }} section-block-{{ section.id }}"
        data-listing-heading
        style="
            {% if heading_color != blank %}--brand-listing-heading-color: {{ heading_color }};{% endif %}
            {% if subheading_color != blank %}--brand-listing-subheading-color: {{ subheading_color }};{% endif %}
            --brand-listing-heading-size: {{ section.settings.heading_size }}px;
            --brand-listing-heading-size-mb: {{ section.settings.heading_size_mobile }}px;
            --brand-listing-subheading-size: {{ section.settings.subheading_size }}px;
            --brand-listing-subheading-size-mb: {{ section.settings.subheading_size_mobile }}px;
            --brand-listing-heading-padding-top: {{ section.settings.padding_top }}px;
            --brand-listing-heading-padding-bottom: {{ section.settings.padding_bottom }}px;
            --brand-listing-heading-padding-top-mb: {{ section.settings.padding_top_mobile }}px;
            --brand-listing-heading-padding-bottom-mb: {{ section.settings.padding_bottom_mobile }}px;
            --brand-listing-heading-bg: {{ section.settings.background_color }};
        "
    >
        <div class="{% if section.settings.container == '1170' %}container-1170{% elsif section.settings.container == '1470' %}container-1470{% elsif section.settings.container == 'fullwidth' %}container-full{% else %}container{% endif %}">
            {%- if heading != blank -%}
                <h2 class="brand-listing-heading__title">{{ heading }}</h2>
            {%- endif -%}
            {%- if subheading != blank -%}
                <div class="brand-listing-heading__subtitle">{{ subheading | newline_to_br }}</div>
            {%- endif -%}
        </div>
    </div>
{%- endif -%}

{% schema %}
{
    "name": "Brand Listing Heading",
    "class": "section-brand-listing-heading",
    "settings": [
        { "type": "header", "content": "Text", "info": "Template-wide: applies to every collection using this template. Leave both empty to hide the section." },
        { "type": "text", "id": "heading", "label": "Title", "default": "The Perfect Size for Every Moment" },
        { "type": "textarea", "id": "subheading", "label": "Subtitle", "default": "Discover our range" },
        {
            "type": "select",
            "id": "content_align",
            "label": "Alignment",
            "default": "center",
            "options": [
                { "value": "left", "label": "Left" },
                { "value": "center", "label": "Center" }
            ]
        },
        { "type": "color", "id": "heading_color", "label": "Title color", "info": "Leave blank to use the heading color of this collection's Brand Banner entry." },
        { "type": "color", "id": "subheading_color", "label": "Subtitle color", "info": "Leave blank to use the subheading color of this collection's Brand Banner entry." },
        { "type": "range", "id": "heading_size", "label": "Title size (desktop)", "min": 18, "max": 60, "step": 1, "unit": "px", "default": 32 },
        { "type": "range", "id": "heading_size_mobile", "label": "Title size (mobile)", "min": 16, "max": 40, "step": 1, "unit": "px", "default": 22 },
        { "type": "range", "id": "subheading_size", "label": "Subtitle size (desktop)", "min": 12, "max": 30, "step": 1, "unit": "px", "default": 18 },
        { "type": "range", "id": "subheading_size_mobile", "label": "Subtitle size (mobile)", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 15 },
        { "type": "header", "content": "Layout" },
        { "type": "color", "id": "background_color", "label": "Section background color", "default": "rgba(0,0,0,0)" },
        { "type": "select", "id": "container", "label": "Container width", "default": "container", "options": [
            { "value": "container", "label": "Standard" },
            { "value": "1170", "label": "1170px" },
            { "value": "1470", "label": "1470px" },
            { "value": "fullwidth", "label": "Full width" }
        ]},
        { "type": "range", "id": "padding_top", "label": "Padding top (desktop)", "min": 0, "max": 150, "step": 5, "unit": "px", "default": 60 },
        { "type": "range", "id": "padding_bottom", "label": "Padding bottom (desktop)", "min": 0, "max": 150, "step": 5, "unit": "px", "default": 0 },
        { "type": "range", "id": "padding_top_mobile", "label": "Padding top (mobile)", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 30 },
        { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom (mobile)", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 0 }
    ],
    "presets": [{ "name": "Brand Listing Heading" }]
}
{% endschema %}
